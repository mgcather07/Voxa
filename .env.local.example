# ---------------------------------------------------------------------------
# VOXA — LOCAL TESTING CONFIG  (SQLite + mock data, no CUCM, no Docker)
# ---------------------------------------------------------------------------
# Quick start on any machine:
#     cp .env.local.example .env
#     source .venv/bin/activate && python scripts/mock_data.py 600 --wipe
#     make dev            # http://localhost:8000
#
# This file is safe to commit: it contains no real secrets. The real .env is
# gitignored. See HANDOFF.md for the full setup walkthrough.
# ---------------------------------------------------------------------------

# Local SQLite database file — no Postgres/Docker needed for testing.
DATABASE_URL=sqlite:///./local.db

# Run without CUCM using seeded mock data (600 fake phones across 5 sites).
MOCK_MODE=true

# Local-development escape hatch: skips login so you can click every page.
# NEVER set this true on a deployed instance.
AUTH_DISABLED=true

# Signs the session cookie. Irrelevant while AUTH_DISABLED=true, so this
# throwaway value is fine for local testing. For any real/deployed instance,
# generate one with:  python scripts/manage.py secret-key
SECRET_KEY=dev-only-not-a-secret-change-for-any-real-use

# ---------------------------------------------------------------------------
# CUCM connection (unused while MOCK_MODE=true — fill in for real data later)
# ---------------------------------------------------------------------------
CUCM_HOST=cucm-pub.example.local
CUCM_USER=voxa-ro
CUCM_PASSWORD=changeme
CUCM_AXL_VERSION=12.5
CUCM_VERIFY_TLS=false

PHONE_WEB_ENABLED=true
PHONE_WEB_TIMEOUT=4
PHONE_WEB_CONCURRENCY=25

SITE_FROM_DEVICE_POOL=^(?:DP_)?(?P<site>[A-Za-z0-9]+)
