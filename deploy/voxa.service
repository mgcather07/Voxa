# systemd unit for a VM where Docker is not approved.
#
#   sudo cp deploy/voxa.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now voxa
#
# Assumes the repo is at /opt/voxa with a venv at .venv, owned by
# a system user 'voxa', and Postgres installed on the VM.

[Unit]
Description=Voxa - CUCM Call Telemetry
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=voxa
Group=voxa
WorkingDirectory=/opt/voxa
EnvironmentFile=/opt/voxa/.env.prod
ExecStart=/opt/voxa/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips '*'
Restart=on-failure
RestartSec=5

# The app writes nothing to disk; all state is in Postgres.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
