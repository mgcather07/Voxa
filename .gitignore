*.db
*.sqlite3
backups/

# Build/ship artifacts (image tarballs, server deploy bundles)
dist/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local CDR/CMR drop dir (sample + real files)
cdr-inbox/*
!cdr-inbox/.gitkeep
