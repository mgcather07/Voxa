# Copy to .env.prod on the VM and fill in. Never commit .env.prod.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# --- Postgres (used by both the db and app services) ------------------------
POSTGRES_USER=voxa
POSTGRES_PASSWORD=
POSTGRES_DB=voxa

# --- Image ------------------------------------------------------------------
# The pre-built image this host runs. Pin it to the exact tag you shipped so a
# deploy is reproducible and rollback is just changing this line. Leave as
# voxa:latest only for quick local testing.
#   - shipped via tarball (docker load):   VOXA_IMAGE=voxa:1.4.0
#   - pulled from a registry:              VOXA_IMAGE=registry.corp.example.com/voice/voxa:1.4.0
VOXA_IMAGE=voxa:latest

# --- App --------------------------------------------------------------------
APP_NAME=Voxa

# Generate with: python scripts/manage.py secret-key
# Changing this signs every user out. Keep it out of git.
SECRET_KEY=

AUTH_BACKEND=local
AUTH_DISABLED=false
SESSION_MAX_AGE=43200
SESSION_HTTPS_ONLY=true

# --- CUCM -------------------------------------------------------------------
CUCM_HOST=cucm-pub.corp.example.com
CUCM_USER=voxa-ro
CUCM_PASSWORD=
CUCM_AXL_VERSION=12.5
CUCM_VERIFY_TLS=false

# --- Phone scraping ---------------------------------------------------------
PHONE_WEB_ENABLED=true
PHONE_WEB_TIMEOUT=4
# Raise carefully. 25 concurrent HTTP requests to phones is polite; several
# hundred looks like a scan to an IPS.
PHONE_WEB_CONCURRENCY=25

# --- Site naming ------------------------------------------------------------
SITE_FROM_DEVICE_POOL=^(?:DP_)?(?P<site>[A-Za-z0-9]+)

# --- LDAP / Active Directory ------------------------------------------------
# AD sign-in is configured in the browser (Settings -> LDAP / Active Directory),
# stored in the database, and verified with the "Test Active Directory" button —
# you don't need these env vars. They exist only as an optional bootstrap
# default before anyone has opened Settings. Set AUTH_BACKEND=ldap to enable it.
# Local accounts always remain as a break-glass path if the directory is down.
# LDAP_URL=ldaps://dc01.corp.example.com:636
# LDAP_BIND_DN=CN=svc-voxa,OU=Service Accounts,DC=corp,DC=example,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=example,DC=com
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_REQUIRED_GROUP=CN=Voice Engineering,OU=Groups,DC=corp,DC=example,DC=com
