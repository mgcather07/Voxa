# ---------------------------------------------------------------------------
# CUCM connection
# ---------------------------------------------------------------------------
# Publisher hostname or IP. AXL only runs on the publisher.
CUCM_HOST=cucm-pub.example.local

# Application User with these roles:
#   Standard AXL API Access
#   Standard CCM Admin Users (Read Only)
#   Standard Serviceability (Read Only)
#   Standard RealtimeAndTraceCollection
CUCM_USER=calltel-ro
CUCM_PASSWORD=changeme

# AXL schema version must be <= your CUCM version. 12.5 works against 12.5-15.
CUCM_AXL_VERSION=12.5

# Set true only if you have loaded the CUCM tomcat cert into a trust store.
CUCM_VERIFY_TLS=false

# ---------------------------------------------------------------------------
# Phone web scraping (serial numbers + CDP switch/port)
# ---------------------------------------------------------------------------
# Requires "Web Access = Enabled" on the phone or Common Phone Profile.
PHONE_WEB_ENABLED=true
PHONE_WEB_TIMEOUT=4
PHONE_WEB_CONCURRENCY=25

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cucm:cucm@localhost:5433/cucm_inventory

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Derive a site name from the device pool using this regex capture group.
# Example: device pool "DP_LOUISVILLE_01" with ^DP_(?P<site>[A-Z]+) -> LOUISVILLE
SITE_FROM_DEVICE_POOL=^(?:DP_)?(?P<site>[A-Za-z0-9]+)

# Set true to run without CUCM using seeded mock data.
MOCK_MODE=false
